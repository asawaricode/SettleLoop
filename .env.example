SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_SECRET_KEY=<your-supabase-service-role-key>
GEMINI_API_KEY=<your-gemini-api-key>

# ── Phase 3: Real Razorpay Test Mode Integration ───────────────────────────
# Obtain from Razorpay Dashboard → Settings → API Keys → Test Mode
RAZORPAY_KEY_ID=rzp_test_<your-key-id>
RAZORPAY_KEY_SECRET=<your-key-secret>

# Set this ONLY after you create a webhook endpoint in Razorpay Dashboard.
# This is NOT generated by API key creation — it is a separate secret you
# choose/copy when creating the webhook in the Razorpay Dashboard.
RAZORPAY_WEBHOOK_SECRET=<your-webhook-secret>
